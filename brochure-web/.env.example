# Copy to .env on the host (never commit real secrets to public git)

PORT=3000
PUBLIC_BASE_URL=https://your-domain.example

# --- Supabase (primary storage) ---
# Project URL + publishable (anon) key from Supabase → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Next.js-compatible aliases (also accepted by server.js)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Run supabase/schema.sql in the Supabase SQL Editor before first submit.

