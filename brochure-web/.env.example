# Copy to .env on the host (never commit real secrets)

PORT=3000
PUBLIC_BASE_URL=https://your-domain.example

# --- Google Sheets (pick ONE path) ---
# Recommended: Apps Script web app URL (see backend-setup.md)
# Script Properties must use these confirmed IDs:
#   WAITLIST_SHEET_ID      = 1DuoOtwG6g_tzNyQi275VxF7QUzMXbNx3ygybODGCzCM
#   REGISTRATION_SHEET_ID  = 15fKInC0I1udku9ChOvMGoIUYy3ehCzpFNAwsUCIoDnU
SHEETS_APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXX/exec

# Optional alternative: service account (requires: npm install googleapis)
WAITLIST_SHEET_ID=1DuoOtwG6g_tzNyQi275VxF7QUzMXbNx3ygybODGCzCM
REGISTRATION_SHEET_ID=15fKInC0I1udku9ChOvMGoIUYy3ehCzpFNAwsUCIoDnU
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Email (pick ONE path) ---
ORGANISER_ALERT_EMAIL=CONTACT@AISEORG.INFO
EMAIL_FROM=CONTACT@AISEORG.INFO

# Resend (https://resend.com) — simplest HTTP API
RESEND_API_KEY=

# OR SMTP
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# OR let Apps Script send mail (GmailApp) — set true and omit Resend/SMTP
# EMAIL_VIA_APPS_SCRIPT=true

# --- Razorpay ---
# Without keys: static razorpay.me link (current behaviour)
RAZORPAY_ME_URL=https://razorpay.me/@rnaclinicindia2027?amount=trAZ1UkbSzNzZMEB9OinbA%3D%3D

# With Key ID + Secret: create a Payment Link per registration (email/SMS notify + reference_id)
# RAZORPAY_KEY_ID=rzp_live_xxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# Optional: create Razorpay Invoice (payment request) instead of Payment Link
# RAZORPAY_CREATE_INVOICE=false

CLINIC_FEE_INR=3850
